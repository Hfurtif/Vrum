# GEMINI_API_KEY & OPENAI_API_KEY: Optionnel pour le pré-remplissage de test via le panneau Secrets d'AI Studio.
# Ne jamais inscrire de vraies clés ici : configurez-les dans le panneau Secrets d'AI Studio
# ou saisissez-les directement dans l'écran « Tes clés IA » de l'application.
GEMINI_API_KEY=MY_GEMINI_API_KEY
OPENAI_API_KEY=MY_OPENAI_API_KEY
